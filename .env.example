# WalletConnect / RainbowKit projectId.
# REQUIRED for WalletConnect + mobile/QR wallet connections. Get a free id at
# https://cloud.reown.com (formerly WalletConnect Cloud). Without a real id, the
# injected + MetaMask connectors still work, but WalletConnect will not initialize.
# Do NOT commit a real id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# EVM chain target (defaults: 31337 / http://127.0.0.1:8545 on local origins only).
# NEXT_PUBLIC_EVM_CHAIN_ID=31337
# NEXT_PUBLIC_EVM_RPC_URL=http://127.0.0.1:8545

# Anvil mock-collateral override (public ERC-20 metadata, safe to expose).
# NEXT_PUBLIC_EVM_ASSETS='{"31337":[{"symbol":"WBTC","name":"Wrapped BTC","address":"0x…","decimals":8}]}'

# Q-Racing mint-bridge voucher signer (Phase 4). SERVER-ONLY — no NEXT_PUBLIC_ prefix.
# A 32-byte hex private key; the derived ADDRESS must equal the on-chain MintClaim `signer`.
# Print the address (never the key) with:
#   MINT_SIGNER_KEY=0x... node scripts/print-mint-signer-address.mjs
# then pass it to the anvil deploy as MINT_SIGNER. Unset => /api/mint/voucher is disabled.
MINT_SIGNER_KEY=

# GitHub PAT for the in-app feedback form. SERVER-ONLY — no NEXT_PUBLIC_ prefix,
# read exclusively by pages/api/feedback.ts. Scope: triccs/membrane-app-feedback,
# contents:write, nothing else. Unset => feedback submission is disabled.
FEEDBACK_GITHUB_TOKEN=

# Canonical production origin for SEO (canonical links, og:url, og:image absolute
# URLs, robots.txt Sitemap line, sitemap <loc>s). No trailing slash, no path.
# Unset => canonical/og:url/og:image tags are omitted and robots/sitemap fall back
# to the request host. Set this before launch (SEO ruleset R4).
NEXT_PUBLIC_SITE_URL=https://app.membrane.money

