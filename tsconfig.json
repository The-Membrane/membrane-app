{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2020"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "components/Bid/StabilityPool.tsx"
  ],
  "exclude": [
    "node_modules",
    // CosmWasm codegen output, marked "DO NOT MODIFY IT BY HAND". The generated
    // *.client.ts files reference response types the generator never emitted
    // (e.g. ConfigResponse is absent from every *.types.ts), which accounted for
    // 76 of the repo's type errors. Nothing imports them — the only live imports
    // from this directory are the *.types.ts files, and those are still
    // typechecked because reachable imports are pulled into the program
    // regardless of this list. Dropping the directory as a compilation root
    // therefore removes dead, unfixable-by-hand noise without losing coverage of
    // any code that actually ships.
    "contracts/generated"
  ]
}
