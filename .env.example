# WalletConnect / RainbowKit projectId.
# REQUIRED for WalletConnect + mobile/QR wallet connections. Get a free id at
# https://cloud.reown.com (formerly WalletConnect Cloud). Without a real id, the
# injected + MetaMask connectors still work, but WalletConnect will not initialize.
# Do NOT commit a real id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# EVM chain target (defaults: 31337 / http://127.0.0.1:8545 on local origins only).
# NEXT_PUBLIC_EVM_CHAIN_ID=31337
# NEXT_PUBLIC_EVM_RPC_URL=http://127.0.0.1:8545
